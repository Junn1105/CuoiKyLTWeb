<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="shop" tagdir="/WEB-INF/tags" %>
<c:set var="base" value="${pageContext.request.contextPath}"/>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Mộc Sách · Cửa hàng bán sách cũ</title><link rel="icon" href="${base}/images/moc-sach-mark.svg"><link rel="stylesheet" href="${base}/css/home.css"><script defer src="${base}/js/home.js"></script></head>
<body data-base="${base}"><div class="store-shell">
<aside class="sidebar"><a class="brand" href="${base}/home"><img src="${base}/images/moc-sach-mark.svg" alt="" width="30" height="30"><span>Mộc Sách<span class="brand-dot">.</span><small>CỬA HÀNG SÁCH CŨ</small></span></a>
<div class="nav-caption">KHÁM PHÁ</div><nav aria-label="Điều hướng chính">
<a class="nav-item active" href="${base}/home" aria-current="page"><span class="nav-icon">⌂</span>Trang chủ</a>
<a class="nav-item" href="${base}/home#categories"><span class="nav-icon">▦</span>Danh mục sách</a>
<a class="nav-item" href="${base}/home#bestsellers"><span class="nav-icon">↗</span>Sách bán chạy</a>
<a class="nav-item" href="${base}/stores"><span class="nav-icon">🏬</span>Hệ thống chi nhánh</a>
<a class="nav-item" href="${base}/cart"><span class="nav-icon">▱</span>Giỏ hàng<c:if test="${cartCount > 0}"> (<c:out value="${cartCount}"/>)</c:if></a>
<a class="nav-item" href="${base}/orders"><span class="nav-icon">▤</span>Đơn hàng của tôi</a>
<c:if test="${isStaffOrAdmin}">
 <c:choose>
  <c:when test="${userContext != null and userContext.isAdmin()}">
   <a class="nav-item" href="${base}/admin"><span class="nav-icon">&#128202;</span>Tổng quan hệ thống</a>
   <a class="nav-item" href="${base}/admin/stores"><span class="nav-icon">&#127970;</span>Quản lý chuỗi & tài khoản</a>
   <a class="nav-item" href="${base}/admin/my-store"><span class="nav-icon">&#127978;</span>Chi nhánh demo</a>
  </c:when>
  <c:when test="${userContext != null and userContext.isManager()}">
   <a class="nav-item" href="${base}/admin/my-store"><span class="nav-icon">&#127978;</span>Không gian chi nhánh</a>
   <a class="nav-item" href="${base}/admin/stores?tab=transfers"><span class="nav-icon">&#128257;</span>Đề xuất điều chuyển</a>
  </c:when>
  <c:otherwise>
   <a class="nav-item" href="${base}/admin/my-store"><span class="nav-icon">&#127978;</span>Không gian chi nhánh</a>
  </c:otherwise>
 </c:choose>
</c:if>
</nav><div class="nav-divider"></div><nav aria-label="Tài khoản">
<a class="nav-item" href="${base}/account"><span class="nav-icon">⚙</span>Tài khoản</a>
<c:choose><c:when test="${not empty displayName}"><form action="${base}/logout" method="post"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="nav-item" type="submit"><span class="nav-icon">↪</span>Đăng xuất</button></form></c:when><c:otherwise><a class="nav-item" href="${base}/login"><span class="nav-icon">↪</span>Đăng nhập</a></c:otherwise></c:choose>
</nav><div class="sidebar-note"><img src="${base}/images/books-scene.svg" alt="Những cuốn sách được trao tay"><strong>Sách cũ, tình yêu mới.</strong><p>Mỗi trang sách đều xứng đáng<br>được đọc thêm một lần.</p></div><div class="sidebar-foot">ĐỌC · GIỮ · SẺ CHIA</div></aside>
<main><header class="topbar"><div class="breadcrumb">Mộc Sách <span>/</span> Khám phá</div><div class="user-actions"><shop:notifications/><c:choose><c:when test="${not empty displayName}"><a class="avatar" href="${base}/account" aria-label="Tài khoản của tôi"><c:choose><c:when test="${hasAvatar}"><img src="${base}/account/avatar" alt="Ảnh đại diện" width="34" height="34"></c:when><c:otherwise>M</c:otherwise></c:choose></a><a class="user-name" href="${base}/account"><c:out value="${displayName}"/></a></c:when><c:otherwise><a class="login-link" href="${base}/login">Đăng nhập <span>↗</span></a></c:otherwise></c:choose></div></header>
<section class="hero"><div class="hero-copy"><span class="eyebrow">NHỮNG TRANG SÁCH TIẾP NỐI</span><h1>Cuốn sách cũ.<br><span>Khám phá mới.</span></h1><p>Tìm một cuốn sách hợp ý, mang một câu chuyện về nhà.</p><a class="hero-link" href="#recommendations">Khám phá sách hay <span>↗</span></a></div><div class="hero-visual"><img src="${base}/images/books-scene.svg" alt="Bộ sưu tập sách Mộc Sách"><span class="hero-stamp">MỘC SÁCH<br><b>Đọc & sẻ chia</b></span></div></section>
<form class="searchbar" action="${base}/home" method="get" role="search"><label class="sr-only" for="category">Danh mục</label><select name="category" id="category"><option value="0">Tất cả danh mục</option><c:forEach items="${categories}" var="cat"><option value="${cat.id}" ${category == cat.id ? 'selected' : ''}><c:out value="${cat.name}"/></option></c:forEach></select><label class="sr-only" for="storeId">Chi nhánh</label><select name="storeId" id="storeId" style="max-width:180px;background:#f8fafc;border:1px solid #cbd5e1;border-radius:8px;padding:6px 10px;font-size:13.5px;color:#1e293b;outline:none;"><option value="0">📍 Tất cả chi nhánh</option><c:forEach items="${stores}" var="st"><option value="${st.id}" ${storeId == st.id ? 'selected' : ''}>📍 <c:out value="${st.name}"/></option></c:forEach></select><div class="search-input"><svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m15.5 15.5 5 5"/></svg><label class="sr-only" for="q">Tìm tên sách hoặc tác giả</label><input id="q" name="q" maxlength="100" placeholder="Nhập tên cuốn sách bạn cần tìm" value="<c:out value='${q}'/>"></div><button type="submit">Tìm kiếm <span>→</span></button></form>
<c:choose><c:when test="${searching}"><section class="book-section" id="recommendations"><div class="section-heading"><div><span class="eyebrow">TÌM MỘT CÂU CHUYỆN</span><h2>Kết quả tìm kiếm <small>(${resultCount})</small></h2></div><a class="view-all" href="${base}/home">Xóa bộ lọc ×</a></div><c:choose><c:when test="${empty books}"><div class="empty-state"><h3>Chưa tìm thấy cuốn sách phù hợp</h3><p>Thử tên sách ngắn hơn, tên tác giả hoặc một danh mục khác nhé.</p></div></c:when><c:otherwise><div class="book-grid"><c:forEach items="${books}" var="book"><shop:book book="${book}"/></c:forEach></div><c:if test="${resultCount > 24}"><p class="section-note">Đang hiển thị 24 kết quả đầu tiên. Hãy chọn danh mục hoặc thêm từ khóa để tìm chính xác hơn.</p></c:if></c:otherwise></c:choose></section></c:when>
<c:otherwise><section class="book-section" id="recommendations"><div class="section-heading"><div><span class="eyebrow">CHỌN CHO BẠN</span><h2>Sách đáng khám phá<span class="blue-dot">.</span></h2><p>Gợi ý từ đánh giá của bạn đọc và lượt mua thực tế.</p></div><a href="#bestsellers" class="view-all">Sách bán chạy ↗</a></div><div class="book-grid"><c:forEach items="${recommended}" var="book"><shop:book book="${book}"/></c:forEach></div><c:if test="${empty recommended}"><p class="empty-state">Những cuốn sách mới sẽ sớm có mặt tại đây.</p></c:if></section></c:otherwise></c:choose>
<section id="categories" class="category-section"><div class="section-heading"><div><span class="eyebrow">MỖI SỞ THÍCH, MỘT GÓC SÁCH</span><h2>Bạn muốn đọc gì?</h2></div><span class="catalog-count">${bookCount} đầu sách</span></div><div class="category-grid"><c:forEach items="${categories}" var="cat"><a class="category-card" href="${base}/home?category=${cat.id}"><img src="${base}<c:out value='${cat.cover}'/>" alt="Sách thuộc danh mục <c:out value='${cat.name}'/>" loading="lazy" data-cover><div><h3><c:out value="${cat.name}"/></h3><span>${cat.count} đầu sách</span></div><span class="category-arrow">↗</span></a></c:forEach></div></section>
<section class="book-section" id="bestsellers"><div class="section-heading"><div><span class="eyebrow">ĐƯỢC BẠN ĐỌC LỰA CHỌN</span><h2>Những cuốn sách bán chạy</h2></div><span class="section-number">01 — MỘC SÁCH</span></div><div class="book-grid"><c:forEach items="${bestsellers}" var="book"><shop:book book="${book}"/></c:forEach></div><c:if test="${empty bestsellers}"><p class="empty-state">Danh sách sẽ xuất hiện khi có đơn hàng hoàn tất.</p></c:if></section>
<footer><span>Mộc Sách<span class="blue-dot">.</span></span><p>Sách được yêu thêm một lần.</p><a href="#">Lên đầu trang ↑</a></footer>
</main></div><div id="toast" role="status" aria-live="polite" ${empty cartSuccess and empty cartError ? 'hidden' : ''}><span><c:out value="${not empty cartSuccess ? cartSuccess : cartError}"/></span><button type="button" aria-label="Đóng thông báo">×</button></div></body></html>
